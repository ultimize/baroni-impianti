# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress migration (opzionale, solo per rilanciare import)
WP_API_BASE=https://elettricistasestrilevante.it/wp-json/wp/v2
WP_AUTH_USER=
WP_AUTH_PASSWORD=

# Email (fase successiva)
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=

# Google Places (fase successiva)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Cookie consent (GDPR audit log)
# Random string >= 32 char usato come salt per hashare l'IP prima di salvarlo
CONSENT_IP_SALT=

# Google Analytics 4 — vuoto = niente tracking; popolare quando Baroni vuole attivare GA
NEXT_PUBLIC_GA_MEASUREMENT_ID=
