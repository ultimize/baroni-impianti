# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress migration (opzionale, solo per rilanciare import)
WP_API_BASE=https://elettricistasestrilevante.it/wp-json/wp/v2
WP_AUTH_USER=
WP_AUTH_PASSWORD=

# Email (Resend) — modulo contatti
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
CONTACT_NOTIFICATION_TO=
CONTACT_REPLY_TO=

# Google Places (fase successiva)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Cookie consent (GDPR audit log)
# Random string >= 32 char usato come salt per hashare l'IP prima di salvarlo
CONSENT_IP_SALT=

# Google Tag Manager — vuoto = niente tracking; popolare con GTM-XXXXXXX per attivare
# Tutti i tag (GA4, Meta Pixel, ecc.) vanno configurati nella dashboard GTM,
# non come componenti React. Pixel: tag con trigger 'Consent Initialization' +
# condizione 'ad_storage=granted'.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 — non più caricato direttamente, GTM lo gestisce.
# Mantenuto per retrocompatibilità.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
