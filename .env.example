# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WordPress migration (opzionale, solo per rilanciare import)
WP_API_BASE=https://elettricistasestrilevante.it/wp-json/wp/v2
WP_AUTH_USER=
WP_AUTH_PASSWORD=

# Email (Resend) — modulo contatti
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
CONTACT_NOTIFICATION_TO=
CONTACT_REPLY_TO=

# Google Places (fase successiva)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Cookie consent (GDPR audit log)
# Random string >= 32 char usato come salt per hashare l'IP prima di salvarlo
CONSENT_IP_SALT=

# --- DEPRECATO ---
# Le seguenti variabili NON sono più lette dal codice.
# Configurare i tracking ID e i codici di verifica SEO da /admin/settings:
#   - tracking_gtm_id, tracking_ga4_id, tracking_clarity_id, tracking_meta_pixel_id
#   - seo_google_site_verification, seo_bing_site_verification
# I valori sono persistiti in site_settings (Supabase) e renderizzati lato server.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_CLARITY_ID=

# CRM (GoHighLevel)
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Opzionale: id utente GHL a cui attribuire le note create dal form
GHL_USER_ID=
